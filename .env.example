NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL. Use a dedicated local database and a least-privilege application role.
DATABASE_URL=postgresql://sirepes_app:change_me@localhost:5432/sirepes
# Set true only when the PostgreSQL server presents a certificate trusted by Node.js.
DATABASE_SSL=false

# Authentication settings.
SESSION_COOKIE_NAME=sirepes_session
SESSION_TTL_HOURS=8

# SMTP is required for administrator-created and reset accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
